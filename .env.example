# Rails Configuration
RAILS_ENV=development
SECRET_KEY_BASE=your_secret_key_base_here_run_bin_rails_secret_to_generate

# Database Configuration (for local/non-Docker development)
# Docker automatically uses postgres:postgres@db:5432
DB_USERNAME=postgres
DB_PASS=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# URL Shortener Configuration
URL_SHORTENER_PROVIDER=shortio

# Short.io Configuration (if using shortio provider)
SHORTIO_API_KEY=your_shortio_api_key_here
SHORTIO_DOMAIN=your.short.domain

# Test Database
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/github_indexer_test
