# =============================================================================
# GITHUB INDEXER - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit the .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Rails Configuration
# -----------------------------------------------------------------------------
RAILS_ENV=development
# Generate with: bin/rails secret
SECRET_KEY_BASE=your_secret_key_base_here_run_bin_rails_secret_to_generate
RAILS_LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# For local development (non-Docker)
DB_USERNAME=postgres
DB_PASS=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Alternative: Use DATABASE_URL (overrides individual DB_ vars)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/github_indexer_development

# Test Database
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/github_indexer_test

# Note: Docker Compose automatically uses postgres:postgres@db:5432

# -----------------------------------------------------------------------------
# Redis Configuration (required for Sidekiq background jobs)
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# URL Shortener Configuration
# -----------------------------------------------------------------------------
# Provider: shortio (default)
URL_SHORTENER_PROVIDER=shortio

# Short.io API (https://short.io)
# Get your API key:
#   1. Sign up at https://short.io (free tier: 1000 URLs/month)
#   2. Go to Settings → Integrations & API
#   3. Copy your API Key
SHORTIO_API_KEY=your_shortio_api_key_here
SHORTIO_DOMAIN=go.short.io

# -----------------------------------------------------------------------------
# Web Scraping Configuration (Chromium/Ferrum)
# -----------------------------------------------------------------------------
# Path to Chrome/Chromium browser
# Linux (Google Chrome): /usr/bin/google-chrome
# Linux (Chromium): /usr/bin/chromium
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Docker/Production: /usr/bin/chromium (default)
CHROME_BIN=/usr/bin/google-chrome

# -----------------------------------------------------------------------------
# Production Settings (Railway/PaaS)
# -----------------------------------------------------------------------------
# Set these in Railway environment variables:

RAILS_SERVE_STATIC_FILES=true  # Required for Railway
# RAILS_LOG_TO_STDOUT is already enabled (see production.rb:38)
# RACK_ENV=production

# Performance tuning (optional):
WEB_CONCURRENCY=1       # Puma workers (Railway auto-detects)
# RAILS_MAX_THREADS=5     # Threads per worker
