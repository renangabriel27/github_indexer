<div class="min-h-screen bg-gradient-to-br from-gray-900 via-slate-900 to-gray-900 flex items-center justify-center px-4">
  <div class="max-w-2xl w-full text-center">
    <!-- Error Icon -->
    <div class="relative mb-8">
      <div class="absolute inset-0 bg-red-500/20 blur-3xl rounded-full"></div>
      <div class="relative bg-slate-800 p-8 rounded-3xl border border-slate-700 inline-block">
        <svg class="w-24 h-24 text-red-400 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
      </div>
    </div>

    <!-- Error Code -->
    <h1 class="text-8xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-pink-400 mb-4">
      500
    </h1>

    <!-- Error Title -->
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
      <%= t('errors.internal_server_error.title') %>
    </h2>

    <!-- Error Message -->
    <p class="text-gray-400 text-lg mb-8 max-w-md mx-auto">
      <%= t('errors.internal_server_error.message') %>
    </p>

    <!-- Action Button -->
    <div class="flex justify-center gap-4">
      <%= link_to root_path, class: "inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-xl text-white font-semibold hover:shadow-lg hover:shadow-indigo-500/50 transition-all duration-200 hover:scale-105" do %>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <%= t('errors.internal_server_error.back_to_home') %>
      <% end %>
    </div>
  </div>
</div>

