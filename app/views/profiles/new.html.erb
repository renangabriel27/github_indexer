<div class="min-h-screen bg-gradient-to-br from-gray-900 via-slate-900 to-gray-900 py-12">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">

    <!-- Back Button -->
    <div class="mb-6">
      <%= render Ui::BackLinkComponent.new(text: "Voltar para perfis", href: profiles_path) %>
    </div>

    <!-- Header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-2xl mb-4">
        <%= render Ui::IconComponent.new(name: :user, size: :xl, css_class: "text-white") %>
      </div>
      <h1 class="text-4xl font-bold text-white mb-2">Adicionar Novo Perfil</h1>
      <p class="text-gray-400">Insira seus dados do GitHub para começar a análise</p>
    </div>

    <!-- Form Card -->
    <div class="bg-slate-800 border border-slate-700 rounded-2xl shadow-2xl overflow-hidden">
      <%= render 'form', profile: @profile %>
    </div>
  </div>
</div>
