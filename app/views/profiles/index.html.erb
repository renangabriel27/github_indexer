<div class="min-h-screen bg-gradient-to-br from-gray-900 via-slate-900 to-gray-900">
  <!-- Hero Section -->
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pt-20 pb-16 text-center">
    <h1 class="text-5xl md:text-6xl font-bold text-white mb-6 leading-tight">
      Descubra perfis incríveis
      <span class="block mt-2 text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-400">
        do GitHub
      </span>
    </h1>

    <p class="text-sm text-gray-500 mb-12">
      Busque por nome, username, localização, organização ou qualquer outro campo
    </p>

    <!-- Search Bar -->
    <%= form_with url: profiles_path, method: :get, class: "mb-8", data: { controller: "search-debounce", search_debounce_target: "form" } do |f| %>
      <div class="relative max-w-3xl mx-auto group">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-300"></div>
        <div class="relative flex items-center bg-slate-800 rounded-2xl border border-slate-700 shadow-2xl overflow-hidden">
          <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
            <svg class="h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>

          <%= f.search_field :q,
              value: params[:q],
              placeholder: "Buscar perfil...",
              class: "w-full bg-transparent border-0 pl-14 pr-24 py-5 text-white placeholder-gray-500 text-lg focus:ring-0 focus:outline-none",
              data: { action: "search-debounce#search" } %>

          <button type="submit" class="absolute right-3 p-3 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-xl hover:shadow-lg hover:shadow-indigo-500/50 transition-all duration-200 hover:scale-105">
            <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </div>
      </div>
    <% end %>

    <!-- Quick Actions -->
    <div class="flex justify-center gap-4 mt-8">
      <%= link_to new_profile_path, class: "inline-flex items-center gap-2 px-6 py-3 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-white font-medium transition-all duration-200 hover:scale-105" do %>
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Adicionar Perfil
      <% end %>
    </div>
  </div>

  <!-- Results Section -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-20">
    <turbo-frame id="profiles">
      <div class="content">
        <% if @profiles.any? %>
          <!-- Results Header -->
          <div class="mb-8">
            <p class="text-gray-400 text-lg">
              Encontrados <span class="text-white font-semibold"><%= @profiles.count %></span> perfis
            </p>
          </div>

          <!-- Profile Cards Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% @profiles.each do |profile| %>
              <%= render ProfileCardComponent.new(profile: profile) %>
            <% end %>
          </div>
        <% else %>
          <!-- Empty State -->
          <div class="flex flex-col items-center justify-center py-32">
            <div class="relative mb-8">
              <div class="absolute inset-0 bg-indigo-500/20 blur-3xl rounded-full"></div>
              <div class="relative bg-slate-800 p-8 rounded-3xl border border-slate-700">
                <svg class="w-20 h-20 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
            </div>

            <h3 class="text-2xl font-bold text-white mb-3">Nenhum perfil encontrado</h3>
            <p class="text-gray-400 text-lg mb-8 max-w-md text-center">
              Tente buscar por outro username ou adicione um novo perfil para começar.
            </p>

            <%= link_to new_profile_path, class: "inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-xl text-white font-semibold hover:shadow-lg hover:shadow-indigo-500/50 transition-all duration-200 hover:scale-105" do %>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Adicionar Primeiro Perfil
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Skeleton Loader -->
      <div class="skeleton hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% 6.times do %>
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 animate-pulse">
              <div class="flex items-center gap-4 mb-6">
                <div class="h-16 w-16 bg-slate-700 rounded-full"></div>
                <div class="flex-1 space-y-3">
                  <div class="h-4 bg-slate-700 rounded-lg w-3/4"></div>
                  <div class="h-3 bg-slate-700 rounded-lg w-1/2"></div>
                </div>
              </div>
              <div class="space-y-3">
                <div class="h-3 bg-slate-700 rounded-lg"></div>
                <div class="h-3 bg-slate-700 rounded-lg w-5/6"></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </turbo-frame>

    <!-- Pagination -->
    <% if @profiles.any? %>
      <div class="mt-12">
        <%= render 'pagination', pagy: @pagy %>
      </div>
    <% end %>
  </div>
</div>