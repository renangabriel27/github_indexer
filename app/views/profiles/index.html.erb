<div class="max-w-7xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold">Perfis GitHub</h1>
    <%= link_to "Novo Perfil", new_profile_path, class: "btn-primary" %>
  </div>

  <%= render 'search_form' %>

  <turbo-frame id="profiles-list" data-turbo-action="advance">
    <% if @profiles.any? %>
      <div class="grid grid-cols-3 gap-6">
        <% @profiles.each do |profile| %>
          <%= render ProfileCardComponent.new(profile: profile) %>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-16">
        <p class="text-gray-500">Nenhum perfil encontrado</p>
      </div>
    <% end %>
  </turbo-frame>

  <div class="mt-8">
    <%== @pagy.series_nav %>
  </div>
</div>