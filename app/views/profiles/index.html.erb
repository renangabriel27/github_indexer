<div class="min-h-screen bg-gradient-to-br from-gray-900 via-slate-900 to-gray-900">
  <!-- Hero Section -->
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pt-12 sm:pt-20 pb-12 sm:pb-16 text-center">
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-4 sm:mb-6 leading-tight">
      Descubra perfis incríveis
      <span class="block mt-2 text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-purple-400">
        do GitHub
      </span>
    </h1>

    <p class="text-sm sm:text-base text-gray-400 sm:text-gray-500 mb-8 sm:mb-12 px-4">
      Busque por nome, username, localização, organização ou qualquer outro campo
    </p>

    <!-- Search Bar -->
    <%= render Ui::SearchBarComponent.new(
      url: profiles_path,
      method: :get,
      placeholder: "Buscar perfil...",
      param_name: :q,
      value: params[:q]
    ) %>

    <!-- Quick Actions -->
    <div class="flex justify-center gap-4 mt-8">
      <%= render Ui::ButtonComponent.new(
        text: "Adicionar Perfil",
        variant: :secondary,
        icon: :plus,
        href: new_profile_path,
        class: "hover:scale-105",
        data: { turbo_frame: "_top" }
      ) %>
    </div>
  </div>

  <!-- Results Section -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-20">
    <turbo-frame id="profiles">
      <div class="content">
        <% if @profiles.any? %>
          <!-- Results Header -->
          <div class="mb-8">
            <p class="text-gray-400 text-lg">
              Encontrados <span class="text-white font-semibold"><%= @pagy.count %></span> perfis
            </p>
          </div>

          <!-- Profile Cards Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% @profiles.each do |profile| %>
              <%= render Profiles::CardComponent.new(profile: profile) %>
            <% end %>
          </div>
        <% else %>
          <!-- Empty State -->
          <%= render Ui::EmptyStateComponent.new(
            icon: :search,
            title: "Nenhum perfil encontrado",
            description: "Tente buscar por outro username ou adicione um novo perfil para começar.",
            cta_text: "Adicionar Primeiro Perfil",
            cta_url: new_profile_path,
            cta_icon: :plus
          ) %>
        <% end %>
      </div>

      <!-- Skeleton Loader -->
      <div class="skeleton hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% 6.times do %>
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-6 animate-pulse">
              <div class="flex items-center gap-4 mb-6">
                <div class="h-16 w-16 bg-slate-700 rounded-full"></div>
                <div class="flex-1 space-y-3">
                  <div class="h-4 bg-slate-700 rounded-lg w-3/4"></div>
                  <div class="h-3 bg-slate-700 rounded-lg w-1/2"></div>
                </div>
              </div>
              <div class="space-y-3">
                <div class="h-3 bg-slate-700 rounded-lg"></div>
                <div class="h-3 bg-slate-700 rounded-lg w-5/6"></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Pagination -->
      <% if @pagy.present? %>
        <%= render 'pagination', pagy: @pagy %>
      <% end %>
    </turbo-frame>
  </div>
</div>
