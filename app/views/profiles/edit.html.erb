<div class="min-h-screen bg-gradient-to-br from-gray-900 via-slate-900 to-gray-900 py-12">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">

    <!-- Back Button -->
    <div class="mb-6">
      <%= render Ui::BackLinkComponent.new(text: "Voltar para o perfil", href: @profile) %>
    </div>

    <!-- Header -->
    <div class="relative mb-8 overflow-hidden rounded-3xl bg-gradient-to-r from-purple-600 via-indigo-600 to-purple-600 p-6 shadow-2xl">
      <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black/20"></div>
      <div class="relative flex flex-col sm:flex-row items-center justify-center gap-6">
        <%= render Profiles::AvatarComponent.new(profile: @profile, size: :md) %>

        <div class="text-center">
          <h1 class="text-4xl font-bold text-white mb-2">Editar Perfil</h1>
          <p class="text-white/90">
            Atualize as informações de
            <span class="font-semibold text-white">@<%= @profile.github_username %></span>
          </p>
        </div>
      </div>
    </div>

    <!-- Form Card -->
    <div class="bg-slate-800 border border-slate-700 rounded-2xl shadow-2xl overflow-hidden">
      <%= render 'form', profile: @profile %>
    </div>

    <!-- Additional Info -->
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Last Scan Info -->
      <div class="p-4 bg-slate-800/50 border border-slate-700/50 rounded-xl">
        <%= render Profiles::InfoCardComponent.new(
          icon: :clock,
          label: "Último scan",
          value: @profile.last_scanned_at.present? ? "#{time_ago_in_words(@profile.last_scanned_at)} atrás" : "Nunca escaneado",
          show: true
        ) %>
      </div>

      <!-- Created At Info -->
      <div class="p-4 bg-slate-800/50 border border-slate-700/50 rounded-xl">
        <%= render Profiles::InfoCardComponent.new(
          icon: :calendar,
          label: "Adicionado em",
          value: l(@profile.created_at, format: :short),
          show: true
        ) %>
      </div>
    </div>

    <!-- Danger Zone -->
    <div class="mt-8 p-6 bg-red-500/5 border border-red-500/20 rounded-xl">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <%= render Ui::IconComponent.new(name: :exclamation_triangle, size: :lg, css_class: "text-red-400") %>
        </div>
        <div class="flex-1">
          <h3 class="text-lg font-semibold text-red-400 mb-2">Zona de Perigo</h3>
          <p class="text-sm text-gray-400 mb-4">
            Remover este perfil irá deletar permanentemente todos os dados associados. Esta ação não pode ser desfeita.
          </p>

          <%= render Shared::ModalComponent.new(
            title: "Confirmar Exclusão",
            description: "Esta ação não pode ser desfeita",
            confirm_text: "Remover",
            confirm_url: profile_path(@profile),
            confirm_method: :delete
          ) do |modal| %>
            <% modal.with_trigger do %>
              <button type="button"
                      class="inline-flex items-center gap-2 px-5 py-2.5 bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 hover:border-red-500/50 rounded-lg text-red-400 font-medium transition-all duration-200"
                      aria-label="Delete profile">
                <%= render Ui::IconComponent.new(name: :trash, size: :md) %>
                Remover Perfil
              </button>
            <% end %>
            <% modal.with_body do %>
              <p>
                Tem certeza que deseja remover o perfil de
                <span class="font-semibold text-white">@<%= @profile.github_username %></span>?
                Todos os dados associados serão perdidos permanentemente.
              </p>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
