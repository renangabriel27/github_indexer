<!-- app/views/profiles/_form.html.erb (versão atualizada) -->
<%= form_with model: profile,
              class: "p-8" do |f| %>

  <!-- Error Summary -->
  <% if profile.errors.any? %>
    <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl animate-shake">
      <div class="flex gap-3">
        <svg class="w-6 h-6 text-red-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="flex-1">
          <h3 class="text-red-400 font-semibold mb-2">
            <%= pluralize(profile.errors.count, "erro") %> <%= profile.errors.count == 1 ? 'impediu' : 'impediram' %> o salvamento:
          </h3>
          <ul class="space-y-1">
            <% profile.errors.full_messages.each do |msg| %>
              <li class="text-red-300 text-sm">• <%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Name Field (Optional) -->
  <div class="mb-6">
    <%= f.label :name, "Nome #{profile.persisted? ? '' : '(obrigatório)'}", class: "block text-sm font-medium text-gray-300 mb-2" %>
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
        <svg class="w-5 h-5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
      </div>
      <%= f.text_field :name,
          placeholder: profile.persisted? ? "Ex: #{profile.github_username}" : "Ex: Linus Torvalds",
          class: "w-full bg-slate-900/50 border pl-12 pr-4 py-3.5 rounded-xl text-white placeholder-gray-500 transition-all focus:outline-none focus:ring-2 #{profile.errors[:name].any? ? 'border-red-500 focus:ring-red-500/50 focus:border-red-500' : 'border-slate-600 focus:ring-indigo-500/50 focus:border-indigo-500'}" %>
    </div>
    <% if profile.errors[:name].any? %>
      <p class="mt-2 text-sm text-red-400 flex items-center gap-1">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
        </svg>
        <%= profile.errors[:name].first %>
      </p>
    <% end %>
  </div>

<!-- app/views/profiles/_form.html.erb - Atualizar apenas a seção do GitHub URL -->

<!-- GitHub URL Field -->
<div class="mb-8">
  <%= f.label :github_username, "Username do GitHub", class: "block text-sm font-medium text-gray-300 mb-2" %>
  <div class="relative">
    <!-- Prefix (read-only) -->
    <div class="absolute inset-y-0 left-0 flex items-center">
      <span class="flex items-center gap-2 px-4 text-gray-500 border-r border-slate-600 h-full bg-slate-900/80 rounded-l-xl">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
        </svg>
        <span class="font-mono text-sm">github.com/</span>
      </span>
    </div>

    <!-- Input Field -->
    <%= f.text_field :github_username,
        placeholder: "username",
        class: "w-full bg-slate-900/50 border pl-44 pr-4 py-3.5 rounded-xl text-white placeholder-gray-500 transition-all focus:outline-none focus:ring-2 #{profile.errors[:github_username].any? ? 'border-red-500 focus:ring-red-500/50 focus:border-red-500' : 'border-slate-600 focus:ring-indigo-500/50 focus:border-indigo-500'}" %>
  </div>

  <% if profile.errors[:github_username].any? %>
    <p class="mt-2 text-sm text-red-400 flex items-center gap-1">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
      </svg>
      <%= profile.errors[:github_username].first %>
    </p>
  <% else %>
    <p class="mt-2 text-sm flex items-center gap-1">
      <svg class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="text-gray-500">Digite apenas o username (ex: torvalds)</span>
    </p>
  <% end %>
  
  <% if profile.persisted? %>
    <div class="mt-3 p-3 bg-yellow-500/10 border border-yellow-500/30 rounded-lg">
      <div class="flex gap-2">
        <svg class="w-5 h-5 text-yellow-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div class="text-sm text-yellow-300">
          <p class="font-medium">Atenção ao alterar o username:</p>
          <p class="text-yellow-400/90 mt-1">Alterar o username irá buscar dados de um perfil diferente do GitHub. Todos os dados anteriores serão substituídos.</p>
        </div>
      </div>
    </div>
  <% end %>
</div>

  <!-- Action Buttons -->
  <div class="flex flex-col sm:flex-row gap-3">
    <%= f.submit profile.persisted? ? "Atualizar Perfil" : "Salvar Perfil",
        class: "flex-1 inline-flex items-center justify-center gap-2 px-6 py-4 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-xl text-white font-semibold hover:shadow-lg hover:shadow-indigo-500/50 transition-all duration-200 hover:scale-[1.02] cursor-pointer",
        data: {
          disable_with: "<svg class='animate-spin h-5 w-5 text-white inline-block mr-2' fill='none' viewBox='0 0 24 24'><circle class='opacity-25' cx='12' cy='12' r='10' stroke='currentColor' stroke-width='4'></circle><path class='opacity-75' fill='currentColor' d='M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z'></path></svg>#{profile.persisted? ? 'Atualizando' : 'Salvando'}..." 
        } %>

    <%= link_to profile.persisted? ? profile : profiles_path,
        class: "inline-flex items-center justify-center gap-2 px-6 py-4 bg-slate-900/50 hover:bg-slate-900 border border-slate-700 rounded-xl text-gray-300 font-medium transition-all duration-200" do %>
      Cancelar
    <% end %>
  </div>
<% end %>