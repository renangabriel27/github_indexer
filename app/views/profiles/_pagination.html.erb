<%#
  Custom pagination partial for Pagy with Tailwind CSS.
  This partial assumes the 'pagy' object is passed in as a local variable.
%>

<% if pagy.pages > 1 %>
  <nav class="flex items-center justify-between px-4 py-3 sm:px-6">
    <div class="flex-1 flex justify-between sm:justify-end">
      <% if pagy.prev %>
        <%= link_to 'Anterior', pagy_url_for(pagy, pagy.prev), class: "relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      <% else %>
        <span class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-white cursor-not-allowed">Anterior</span>
      <% end %>

      <% if pagy.next %>
        <%= link_to 'Próxima', pagy_url_for(pagy, pagy.next), class: "ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      <% else %>
        <span class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-white cursor-not-allowed">Próxima</span>
      <% end %>
    </div>
  </nav>
<% end %>