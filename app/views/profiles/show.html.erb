<%= turbo_stream_from @profile %>

<!-- Progress Modal -->
<%= render Profiles::ProgressModalComponent.new(profile: @profile) %>

<div class="min-h-screen bg-gradient-to-br from-gray-900 via-slate-900 to-gray-900 py-12">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

    <!-- Flash Messages -->
    <div id="flash-container">
      <%= render Ui::FlashComponent.new(message: notice, type: :notice) if notice.present? %>
      <%= render Ui::FlashComponent.new(message: alert, type: :alert) if alert.present? %>
    </div>

    <!-- Processing Banner -->
    <div id="processing-banner"
         class="mb-6 p-4 bg-blue-500/10 border border-blue-500/30 rounded-xl <%= 'hidden' unless @profile.scraping_status == 'processing' %>"
         data-profile-status-polling-target="processingBanner">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 flex-1">
        <%= render Ui::IconComponent.new(name: :spinner, size: :md, css_class: "text-blue-400 flex-shrink-0 animate-spin") %>
        <div class="flex-1">
          <p class="text-blue-400 font-medium">Atualizando perfil...</p>
          <p class="text-blue-300 text-sm mt-1">Aguarde enquanto coletamos as informações mais recentes do GitHub.</p>
        </div>
      </div>
    </div>

    <!-- Back Link -->
    <div class="mb-6">
      <%= render Ui::BackLinkComponent.new(text: "Voltar para perfis", href: profiles_path) %>
    </div>

    <div class="bg-slate-800 border border-slate-700 rounded-3xl shadow-2xl overflow-hidden">
      <!-- Header with Avatar and Basic Info -->
      <%= render Profiles::HeaderComponent.new(profile: @profile) %>

      <!-- Stats Grid (wrapped in Turbo Frame for updates) -->
      <turbo-frame id="profile-stats-frame">
        <%= render partial: "profiles/stats", locals: { profile: @profile } %>
      </turbo-frame>

      <!-- Action Buttons -->
      <div class="p-6 sm:p-8 bg-slate-900/50 flex flex-col sm:flex-row sm:flex-wrap gap-3">
        <%= button_to rescan_profile_path(@profile),
            class: "inline-flex items-center justify-center gap-2 px-6 py-3 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-xl text-white font-semibold hover:shadow-lg hover:shadow-indigo-500/50 transition-all duration-200 hover:scale-105" do %>
          <%= render Ui::IconComponent.new(name: :refresh, size: :md) %>
          Re-escanear
        <% end %>

        <%= render Ui::ButtonComponent.new(
          text: "Editar",
          variant: :secondary,
          icon: :edit,
          href: edit_profile_path(@profile),
          class: "w-full sm:w-auto justify-center"
        ) %>

        <%= render Shared::ModalComponent.new(
          title: "Confirmar Exclusão",
          description: "Esta ação não pode ser desfeita",
          confirm_text: "Remover",
          confirm_url: profile_path(@profile),
          confirm_method: :delete
        ) do |modal| %>
          <% modal.with_trigger do %>
            <button type="button"
                    class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 rounded-xl text-red-400 font-medium transition-all duration-200 w-full sm:w-auto"
                    aria-label="Delete profile">
              <%= render Ui::IconComponent.new(name: :trash, size: :md) %>
              Remover
            </button>
          <% end %>
          <% modal.with_body do %>
            <p>
              Tem certeza que deseja remover o perfil de
              <span class="font-semibold text-white">@<%= @profile.github_username %></span>?
              Todos os dados associados serão perdidos permanentemente.
            </p>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
