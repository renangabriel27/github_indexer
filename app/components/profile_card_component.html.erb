<!-- app/components/profile_card_component.html.erb -->
<div class="group relative bg-slate-800 border border-slate-700 rounded-2xl p-6 hover:bg-slate-750 hover:border-slate-600 transition-all duration-300 hover:shadow-xl hover:shadow-indigo-500/10 hover:-translate-y-1">
  <!-- Action Icons - Top Right Corner -->
  <div class="absolute top-4 right-4 z-10 flex items-center gap-2">
    <!-- View Icon -->
    <%= link_to profile_path(@profile), 
        class: "p-2 bg-slate-700/80 hover:bg-slate-600 border border-slate-600 rounded-lg text-gray-400 hover:text-white transition-all duration-200 hover:scale-110 hover:shadow-lg",
        onclick: "event.stopPropagation();",
        title: "Visualizar perfil" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
      </svg>
    <% end %>

    <!-- Edit Icon -->
    <%= link_to edit_profile_path(@profile), 
        class: "p-2 bg-slate-700/80 hover:bg-slate-600 border border-slate-600 rounded-lg text-gray-400 hover:text-white transition-all duration-200 hover:scale-110 hover:shadow-lg",
        onclick: "event.stopPropagation();",
        title: "Editar perfil" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
    <% end %>
  </div>

  <%= link_to profile_path(@profile), class: "block" do %>
    <div class="flex items-center gap-4 mb-4">
      <%= image_tag @profile.avatar_url || "https://github.com/identicons/#{@profile.github_username}.png", 
          class: "h-16 w-16 rounded-full ring-2 ring-slate-600 group-hover:ring-indigo-500 transition-all",
          alt: @profile.name || @profile.github_username %>

      <div class="flex-1 min-w-0">
        <h3 class="text-lg font-bold text-white truncate group-hover:text-indigo-400 transition-colors">
          <%= @profile.name || @profile.github_username %>
        </h3>
        <% if @profile.short_github_url.present? %>
          <a href="<%= @profile.short_github_url %>" 
             target="_blank" 
             rel="noopener noreferrer"
             onclick="event.stopPropagation();"
             class="inline-flex items-center gap-1.5 text-sm text-indigo-400 hover:text-indigo-300 transition-colors group/link truncate">
            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
            <span class="truncate"><%= @profile.github_username %></span>
            <svg class="w-3 h-3 opacity-0 group-hover/link:opacity-100 transition-opacity flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        <% else %>
          <p class="text-sm text-gray-400 truncate">
            @<%= @profile.github_username %>
          </p>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-4 text-sm">
      <div class="flex items-center gap-1.5 text-gray-400">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span><%= @profile.followers || 0 %> followers</span>
      </div>

      <div class="flex items-center gap-1.5 text-gray-400">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        <span><%= @profile.stars || 0 %> stars</span>
      </div>
    </div>

    <!-- Footer with date -->
    <div class="mt-4 pt-4 border-t border-slate-700">
      <p class="text-xs text-gray-500">
        Adicionado em <%= l(@profile.created_at, format: :short) %>
      </p>
    </div>
  <% end %>
</div>