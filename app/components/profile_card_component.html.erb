<div class="card group hover:shadow-lg transition-shadow">
  <div class="flex items-start gap-4">
    <%= image_tag @profile.avatar_url || "https://via.placeholder.com/64",
        class: "w-16 h-16 rounded-full ring-2 ring-gray-100" %>

    <div class="flex-1 min-w-0">
      <h3 class="font-bold text-lg truncate"><%= @profile.name %></h3>
      <p class="text-gray-600 text-sm"><%= @profile.github_username %></p>

      <div class="flex gap-4 mt-2 text-sm text-gray-600">
        <span><%= @profile.followers %> followers</span>
        <span><%= @profile.stars %> stars</span>
      </div>
    </div>

    <div class="flex gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
      <%= link_to profile_path(@profile), class: "btn-icon btn-secondary" do %>
        👁️
      <% end %>
      <%= link_to edit_profile_path(@profile), class: "btn-icon btn-secondary" do %>
        ✏️
      <% end %>
    </div>
  </div>
</div>