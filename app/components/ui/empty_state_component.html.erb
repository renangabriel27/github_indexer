<div class="<%= container_classes %>">
  <div class="<%= icon_outer_container_classes %>">
    <div class="<%= icon_glow_classes %>"></div>
    <div class="<%= icon_container_classes %>">
      <%= render Ui::IconComponent.new(name: icon, size: :xl, css_class: "w-20 h-20 text-gray-500") %>
    </div>
  </div>

  <h3 class="<%= title_classes %>"><%= title %></h3>
  <p class="<%= description_classes %>"><%= description %></p>

  <% if show_cta? %>
    <%= render Ui::ButtonComponent.new(
      text: cta_text,
      variant: :primary,
      icon: cta_icon,
      href: cta_url,
      data: { turbo_frame: "_top" }
    ) %>
  <% end %>
</div>
