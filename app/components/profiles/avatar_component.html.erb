<div class="<%= outer_container_classes %>">
  <div class="<%= glow_classes %>"></div>
  <% if avatar_url.present? %>
    <%= image_tag avatar_url,
        class: avatar_classes,
        alt: alt_text,
        data: { profile_avatar: true } %>
  <% else %>
    <div class="<%= placeholder_classes %>" data-profile-avatar-placeholder>
      <span class="<%= initial_classes %>"><%= initial %></span>
    </div>
  <% end %>
</div>
