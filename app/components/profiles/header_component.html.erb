<div class="<%= container_classes %>">
  <div class="<%= flex_container_classes %>">
    <!-- Avatar -->
    <%= render Profiles::AvatarComponent.new(profile: profile, size: :lg) %>

    <!-- Name and Username -->
    <div class="<%= info_container_classes %>">
      <h1 class="<%= name_classes %>" data-profile-name>
        <%= profile.name %>
      </h1>

      <div class="<%= meta_container_classes %>">
        <a href="<%= profile.short_github_url %>"
           target="_blank"
           rel="noopener noreferrer"
           class="<%= github_link_classes %>">
          <%= render Ui::IconComponent.new(name: :github, size: :md) %>
          @<%= profile.github_username %>
        </a>

        <% if show_location? %>
          <span class="<%= location_container_classes %>" data-profile-location-container>
            <%= render Ui::IconComponent.new(name: :location_marker, size: :sm) %>
            <span data-profile-location><%= profile.location %></span>
          </span>
        <% end %>
      </div>

      <!-- Status Badge -->
      <%= render Profiles::StatusBadgeComponent.new(status: profile.scraping_status) %>
    </div>
  </div>
</div>
